NODE_ENV=development
PORT=5000
# Transactions require Atlas or a local replica set.
MONGO_URI=mongodb://127.0.0.1:27017/dripstore_dev?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRE=1d
CLIENT_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace_with_the_dashboard_webhook_secret
CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace
# Set only for a trusted, fixed proxy topology.
TRUST_PROXY_HOPS=
# Required with --allow-delete for development seeding.
SEED_DATABASE_NAME=dripstore_dev
